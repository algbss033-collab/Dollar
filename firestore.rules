hererules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /* التحقق من المدير */

    function isAdmin() {

      return request.auth != null

        && exists(
          /databases/$(database)/documents/adminUsers/$(request.auth.uid)
        )

        && get(
          /databases/$(database)/documents/adminUsers/$(request.auth.uid)
        ).data.active == true;

    }


    /* إعدادات المتجر */

    match /settings/{docId} {

      allow read:
        if true;

      allow write:
        if isAdmin();

    }


    /* التطبيقات والأسعار */

    match /apps/{appId} {

      allow read:
        if true;

      allow write:
        if isAdmin();

    }


    /* الطلبات */

    match /orders/{orderId} {

      /*
       العميل يستطيع إنشاء طلب
      */

      allow create:

        if request.auth != null

        && request.resource.data.status ==
           "pending"

        && request.resource.data.amount
           is number

        && request.resource.data.senderPhone
           is string

        && request.resource.data.customerId
           is string

        && request.resource.data.receiptUrl
           is string;


      /*
       المدير يستطيع قراءة الطلبات
      */

      allow read:
        if isAdmin();


      /*
       المدير يستطيع تحديث الطلب
      */

      allow update:
        if isAdmin();


      allow delete:
        if isAdmin();

    }


    /* حسابات المدير */

    match /adminUsers/{uid} {

      allow read:

        if request.auth != null
        && request.auth.uid == uid;

      allow write:
        if false;

    }

  }

}
