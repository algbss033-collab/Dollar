rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {


    match /orders/{orderId}/{fileName} {


      /*
       العميل يستطيع رفع صورة التحويل
      */

      allow write:

        if request.auth != null

        && request.resource.size <
           5 * 1024 * 1024

        && request.resource.contentType
           .matches('image/.*');


      /*
       المستخدم المسجل يستطيع قراءة الصورة
      */

      allow read:

        if request.auth != null;

    }

  }

}
